{
  "name": "damascus-health-directorate-central-warehouses",
  "version": "1.0.0",
  "private": true,
  "description": "مستودعات مديرية صحة دمشق المركزية — تطبيق سطح مكتب محلي بالكامل",
  "main": "out/main/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/core.test.ts --bundle --platform=node --format=cjs --target=node20 --alias:@shared=./src/shared --outfile=tests/.build/core.test.cjs && node --test tests/.build/core.test.cjs",
    "test:e2e": "esbuild tests/scenario.e2e.ts --bundle --platform=node --format=cjs --target=node20 --alias:@shared=./src/shared --outfile=tests/.build/scenario.e2e.cjs && node tests/.build/scenario.e2e.cjs",
    "verify": "npm run typecheck && npm run test && npm run test:e2e && npm run build",
    "setup:electron": "node scripts/setup-electron.mjs",
    "build:portable": "npm run build && node scripts/build-portable.mjs",
    "dist": "electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "sy.moh.damascus.centralwarehouses",
    "productName": "Damascus Health Directorate Central Warehouses",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "WHSHAM-CentralWarehouses-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
